# ===== 必填：BotFather 给的 token（不要提交到 GitHub）=====
BOT_TOKEN=

# ===== 管理员 Telegram 数字 ID，多个用逗号分隔，例如：123456789,987654321 =====
# 查自己的 ID：给 @userinfobot 发任意消息，它会返回你的 id
ADMIN_IDS=

# ===== 运行模式：webhook（Render/线上）或 polling（仅本地调试）=====
BOT_MODE=webhook

# ===== webhook 地址：Render 上填 https://<你的服务名>.onrender.com =====
# 本地调试 polling 模式时可留空
WEBHOOK_URL=
WEBHOOK_PATH=/telegram-webhook

# ===== 服务器端口：Render 会注入 $PORT，不要写死 =====
PORT=3000

# ===== bot 用户名（不带 @），用于生成邀请链接；留空则启动时自动获取 =====
BOT_USERNAME=

# ===== 收款占位符：USDT-TRC20 收款地址（等用户确认后填真实地址）=====
USDT_TRC20_ADDRESS=

# ===== 钱包币种（占位，默认 USDT）=====
WALLET_CURRENCY=USDT

# ===== 邀请返佣比例（占位，0.05 = 5%）=====
REFERRAL_RATE=0.05

# ===== 等级门槛（累计消费 USD）：Silver 由截图推断为 100；Gold / Platinum 为占位 =====
LEVEL_SILVER_MIN=100
LEVEL_GOLD_MIN=500
LEVEL_PLATINUM_MIN=1000

# ===== 客服占位符：客服 Telegram 用户名，不带 @，例如 support_username =====
SUPPORT_USERNAME=

# ===== 数据库路径 =====
DB_PATH=./data/store.db

# ===== 默认语言 zh / en =====
DEFAULT_LANG=zh
